# Copy this file to .env and fill in real values. .env is gitignored.

# Tradovate (demo/simulated account credentials -- get these free at
# https://trader.tradovate.com after signing up for a demo account)
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=trading-bot
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEMO=true

# Interactive Brokers (only needed if you go the IBKR route instead)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
